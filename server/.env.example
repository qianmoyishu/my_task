# Huawei Cloud OBS Configuration
OBS_ACCESS_KEY_ID=your_access_key_id
OBS_SECRET_ACCESS_KEY=your_secret_access_key
OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET_NAME=your_bucket_name

# Separate OBS bucket for pain inference results.
# It reuses OBS_ACCESS_KEY_ID and OBS_SECRET_ACCESS_KEY above.
PAIN_OBS_ENDPOINT=obs.cn-east-3.myhuaweicloud.com
PAIN_OBS_BUCKET_NAME=analized
PAIN_OBS_PREFIX=inference_results/
