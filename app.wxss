/**app.wxss**/
page {
  --primary-color: #d9822b;
  --primary-strong: #c66a17;
  --secondary-color: #f0b46a;
  --success-color: #7a9d58;
  --warning-color: #df8a2f;
  --error-color: #ca6a63;
  --text-color: #5c4638;
  --text-color-light: #9a7f6d;
  --background-color: #fff4ea;
  --surface-color: #fffaf5;
  --surface-soft: #fff0df;
  --border-color: #f1dcc8;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  color: var(--text-color);
  font-size: 28rpx;
  background: linear-gradient(180deg, #fff9f4 0%, #fff2e8 52%, #ffefe3 100%);
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 26rpx;
}

.card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  background: linear-gradient(180deg, rgba(255, 250, 245, 0.98) 0%, rgba(255, 246, 236, 0.96) 100%);
  border: 1rpx solid rgba(232, 190, 145, 0.42);
  border-radius: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(202, 144, 74, 0.12);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.font-bold {
  font-weight: bold;
}

.margin-top {
  margin-top: 20rpx;
}

.margin-bottom {
  margin-bottom: 20rpx;
}

.text-primary {
  color: var(--primary-color);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-error {
  color: var(--error-color);
}

.text-light {
  color: var(--text-color-light);
}

.text-small {
  font-size: 24rpx;
}

.text-large {
  font-size: 32rpx;
}

.text-xlarge {
  font-size: 40rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 10rpx;
}

.dot-online {
  background-color: var(--success-color);
}

.dot-offline {
  background-color: var(--error-color);
}

button::after {
  border: none;
}
