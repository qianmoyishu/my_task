/**app.wxss**/
page {
  --primary-color: #1989fa;
  --success-color: #07c160;
  --warning-color: #ff8f00;
  --error-color: #ee0a24;
  --text-color: #323233;
  --text-color-light: #969799;
  --background-color: #f7f8fa;
  --border-color: #ebedf0;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  color: var(--text-color);
  font-size: 28rpx;
  background-color: var(--background-color);
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.font-bold {
  font-weight: bold;
}

.margin-top {
  margin-top: 20rpx;
}

.margin-bottom {
  margin-bottom: 20rpx;
}

.text-primary {
  color: var(--primary-color);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-error {
  color: var(--error-color);
}

.text-light {
  color: var(--text-color-light);
}

.text-small {
  font-size: 24rpx;
}

.text-large {
  font-size: 32rpx;
}

.text-xlarge {
  font-size: 40rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 10rpx;
}

.dot-online {
  background-color: var(--success-color);
}

.dot-offline {
  background-color: var(--error-color);
} 