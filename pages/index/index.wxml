<!-- -*- coding: utf-8 -*- -->
<view class="container">
  <device-overview
    deviceKeyInput="{{deviceKeyInput}}"
    deviceName="{{deviceName}}"
    deviceStatus="{{deviceStatus}}"
    lastUpdatedTime="{{lastUpdatedTime}}"
    isLoading="{{isLoading}}"
    error="{{error}}"
    bind:devicekeyinput="onDeviceKeyInputFromComponent"
    bind:submitkey="onSubmitDeviceKey"
    bind:refresh="onRefresh"
  ></device-overview>

  <metric-switch
    currentType="{{currentType}}"
    showThermal="{{showThermal}}"
    bind:changetype="onChangeTypeFromComponent"
    bind:togglethermal="toggleThermal"
  ></metric-switch>
  
  <thermal-panel
    id="thermalPanel"
    wx:if="{{showThermal}}"
    thermalGrid="{{thermalGrid}}"
    thermalHistory="{{thermalHistory}}"
    thermalHistoryIndex="{{thermalHistoryIndex}}"
    colorScheme="{{colorScheme}}"
    bind:prev="prevThermalHistory"
    bind:next="nextThermalHistory"
    bind:schemechange="changeColorScheme"
  ></thermal-panel>

  <view class="card data-card medical-card metric-card metric-{{currentType}}">
    <view class="metric-glow"></view>
    <view class="data-header">
      <view class="data-title">{{currentType === 'Gsr' ? '皮肤电导' : (currentType === 'MLX90600' ? '体温' : '心率')}}</view>
      <view class="data-value">{{currentData.current}}{{currentData.unit}}</view>
    </view>
    <history-panel
      availableDates="{{availableDates}}"
      datesLoading="{{datesLoading}}"
      selectedDateKeys="{{selectedDateKeys}}"
      obsHistory="{{obsHistory}}"
      obsLoading="{{obsLoading}}"
      showHistory="{{showHistory}}"
      pagedHistory="{{pagedHistory}}"
      historyPage="{{historyPage}}"
      currentData="{{currentData}}"
      bind:cleardates="clearSelectedDates"
      bind:loaddates="loadAvailableDates"
      bind:toggledate="onToggleDateFile"
      bind:togglehistory="toggleHistory"
      bind:refreshhistory="refreshObsHistory"
      bind:prevpage="prevHistoryPage"
      bind:nextpage="nextHistoryPage"
    ></history-panel>
    <chart-panel
      id="chartPanel"
      chartDataPoints="{{chartDataPoints}}"
      centerPointData="{{centerPointData}}"
      currentData="{{currentData}}"
      sliderIndex="{{sliderIndex}}"
      sliderPercent="{{sliderPercent}}"
      chartPage="{{chartPage}}"
      chartTotalPages="{{chartTotalPages}}"
      chartWidth="{{chartWidth}}"
      bind:sliderchange="onSliderChange"
      bind:sliderchanging="onSliderChanging"
      bind:chartscroll="onChartScroll"
      bind:prevpage="onChartScrollToLeft"
      bind:nextpage="onChartScrollToRight"
    ></chart-panel>
  </view>
</view>
