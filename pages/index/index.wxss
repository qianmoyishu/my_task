.device-selector-card {
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.98) 0%, rgba(255, 236, 214, 0.98) 100%);
}

.selector-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.selector-label {
  font-size: 28rpx;
  color: #8d6f5b;
  flex-shrink: 0;
}

.device-key-input {
  flex: 1;
  min-width: 280rpx;
  height: 68rpx;
  padding: 0 22rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(232, 190, 145, 0.78);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.submit-key-btn {
  min-width: 132rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  text-align: center;
  background: linear-gradient(135deg, #eca85f 0%, #d77a2f 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(215, 122, 47, 0.24);
}

.current-device-info {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(232, 190, 145, 0.42);
  display: flex;
  align-items: center;
}

.current-label {
  font-size: 26rpx;
  color: #9f8573;
  margin-right: 10rpx;
}

.current-name {
  font-size: 28rpx;
  color: #bc6b2d;
  font-weight: 600;
}

.header-card {
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, rgba(255, 247, 236, 0.98) 0%, rgba(255, 232, 206, 0.98) 100%);
  box-shadow: 0 14rpx 34rpx rgba(214, 145, 74, 0.16);
}

.header-kicker {
  font-size: 22rpx;
  color: #b97b45;
  margin-bottom: 10rpx;
}

.device-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #6a4b37;
}

.device-status {
  font-size: 28rpx;
  align-items: center;
}

.status-text {
  color: #8a6752;
  font-weight: 600;
}

.updated-time {
  margin-top: 20rpx;
  color: #9f7f69;
}

.refresh-button {
  background: linear-gradient(135deg, #f0b46a 0%, #db8542 100%);
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 20rpx rgba(219, 133, 66, 0.22);
}

.loading {
  animation: rotating 1.5s linear infinite;
}

@keyframes rotating {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.error-card {
  background: linear-gradient(135deg, #fff6f3 0%, #ffefea 100%);
  border-left: 8rpx solid var(--error-color);
}

.error-message {
  color: var(--error-color);
  font-size: 28rpx;
}

.data-card {
  margin-bottom: 30rpx;
  overflow: visible;
}

.medical-card {
  border-top: 8rpx solid var(--primary-color);
  background: linear-gradient(180deg, rgba(255, 251, 246, 0.98) 0%, rgba(255, 245, 235, 0.98) 100%);
}

.metric-card {
  position: relative;
  overflow: hidden;
  animation: cardEnter 380ms ease-out 160ms both;
}

.metric-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 220rpx;
  height: 8rpx;
  background: linear-gradient(90deg, rgba(240, 180, 106, 0), rgba(217, 130, 43, 0.78));
  border-radius: 0 18rpx 0 18rpx;
}

.metric-Gsr {
  border-top-color: #cf8a42;
}

.metric-MLX90600 {
  border-top-color: #e2a84a;
}

.metric-Heart_rate {
  border-top-color: #c96f66;
}

.data-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.data-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6a4b37;
}

.data-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #b8611f;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 241, 220, 0.8);
  animation: valuePop 260ms ease-out both;
}

.history-container {
  margin-top: 30rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(232, 190, 145, 0.55);
}

.history-title {
  font-size: 28rpx;
  font-weight: 700;
}

.history-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-refresh,
.history-toggle,
.refresh-dates-btn,
.clear-dates-btn {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 231, 0.92);
  transition: transform 140ms ease, opacity 140ms ease;
}

.history-refresh,
.history-toggle,
.refresh-dates-btn {
  color: #c66a17;
  border: 1rpx solid rgba(217, 130, 43, 0.45);
}

.clear-dates-btn {
  color: #c4695d;
  border: 1rpx solid rgba(202, 106, 99, 0.45);
  background: rgba(255, 244, 241, 0.92);
}

.history-body-show {
  max-height: 400rpx;
  transition: max-height 0.3s ease;
  overflow: hidden;
  animation: historyDrop 260ms ease-out both;
}

.history-body-hide {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.history-list {
  max-height: 400rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(241, 220, 200, 0.8);
  animation: listFade 240ms ease-out both;
}

.history-time,
.obs-loading,
.no-data,
.no-dates,
.page-info,
.page-hint,
.slider-time,
.stat-label,
.thermal-range,
.thermal-page,
.current-label,
.date-label {
  color: #9a7f6d;
}

.history-time {
  font-size: 24rpx;
}

.history-value {
  font-size: 26rpx;
  font-weight: 700;
}

.no-data,
.no-dates,
.no-thermal {
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
}

.switch-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin: 18rpx 0 12rpx 0;
  width: 100%;
}

.switch-group {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  width: 100%;
  flex-wrap: wrap;
}

.switch-btn {
  flex: 1;
  min-width: 0;
  max-width: 200rpx;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 236, 0.92);
  color: #8a6752;
  border: 1rpx solid rgba(232, 190, 145, 0.62);
  font-weight: 700;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.switch-btn.active {
  background: linear-gradient(135deg, #efb267 0%, #d67a30 100%);
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(214, 122, 48, 0.22);
}

.thermal-btn {
  background: rgba(255, 236, 215, 0.95) !important;
  color: #bc6422 !important;
  border: 1rpx solid rgba(235, 154, 78, 0.52) !important;
}

.thermal-btn.active {
  background: linear-gradient(135deg, #f29d54 0%, #dd7438 100%) !important;
  color: #fff !important;
  box-shadow: 0 8rpx 16rpx rgba(221, 116, 56, 0.22);
}

.thermal-card {
  border-top: 8rpx solid #ea9147;
  background: linear-gradient(180deg, rgba(255, 249, 241, 0.98) 0%, rgba(255, 241, 225, 0.98) 100%);
}

.panel-enter {
  animation: panelEnter 320ms ease-out both;
}

.thermal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.thermal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6a4b37;
}

.thermal-history-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: rgba(255, 246, 233, 0.96);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.thermal-nav-btn {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #eca45c 0%, #d77a2f 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  transition: transform 140ms ease, opacity 140ms ease;
}

.thermal-nav-btn.disabled {
  background: #d7c3b3;
  color: #fff7ef;
}

.thermal-nav-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thermal-time {
  font-size: 24rpx;
  color: #7f614d;
}

.color-scheme-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.scheme-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(232, 190, 145, 0.7);
  border-radius: 999rpx;
  color: #8a6752;
  background: rgba(255, 248, 238, 0.95);
  transition: transform 140ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.scheme-btn.active {
  background: linear-gradient(135deg, #efb267 0%, #d77a2f 100%);
  color: #fff;
  border-color: #d77a2f;
  animation: activePop 220ms ease-out both;
}

.thermal-canvas-wrap {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.thermal-canvas {
  border: 1rpx solid rgba(232, 190, 145, 0.46);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5), 0 10rpx 20rpx rgba(196, 126, 61, 0.1);
}

.thermal-grid {
  display: flex;
  flex-direction: column;
  margin: 20rpx 0;
}

.thermal-row {
  display: flex;
  justify-content: center;
}

.thermal-cell {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  transition: transform 160ms ease, opacity 160ms ease;
}

.cell-temp {
  font-size: 18rpx;
  color: #fff;
  text-shadow: 0 0 2px rgba(67, 35, 12, 0.85);
}

.thermal-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(255, 245, 232, 0.95);
  border-radius: 14rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #6a4b37;
}

.available-dates-row {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: rgba(255, 245, 232, 0.94);
  border-radius: 14rpx;
}

.dates-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dates-actions {
  display: flex;
  gap: 12rpx;
}

.dates-scroll {
  white-space: nowrap;
  padding: 8rpx 0;
}

.date-tag {
  display: inline-block;
  padding: 12rpx 20rpx;
  margin-right: 12rpx;
  background: rgba(255, 251, 246, 0.96);
  border: 1rpx solid rgba(232, 190, 145, 0.62);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #7d604d;
  transition: transform 140ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.date-tag.selected {
  background: linear-gradient(135deg, #efb267 0%, #d77a2f 100%);
  color: #fff;
  border-color: #d77a2f;
  animation: activePop 220ms ease-out both;
}

.date-tag.selected.empty {
  background: #baa28d;
  border-color: #baa28d;
  color: #fff;
}

.obs-badge {
  font-size: 22rpx;
  color: #c57933;
  font-weight: 400;
  margin-left: 10rpx;
}

.history-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0 0 0;
}

.page-btn {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 231, 0.92);
  color: #c66a17;
  border: 1rpx solid rgba(217, 130, 43, 0.45);
  font-size: 22rpx;
  transition: transform 140ms ease, opacity 140ms ease;
}

.slider-chart-wrapper {
  padding: 16rpx 0 0 0;
  background: rgba(255, 245, 232, 0.95);
  border-radius: 14rpx 14rpx 0 0;
  animation: panelEnter 260ms ease-out both;
}

.slider-data {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
  padding: 0 20rpx;
}

.slider-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #d77a2f;
}

.slider-line-container {
  position: relative;
  height: 80rpx;
  margin-left: 80rpx;
  margin-right: 60rpx;
}

.data-slider {
  margin: 0;
  width: 100%;
}

.slider-indicator-line {
  position: absolute;
  top: 50rpx;
  height: 620rpx;
  width: 4rpx;
  background: repeating-linear-gradient(
    to bottom,
    #d77a2f 0,
    #d77a2f 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 25;
  transition: left 0.1s ease-out;
}

.chart-container-wrapper {
  width: 100%;
  height: 600rpx;
  margin-top: 30rpx;
  display: flex;
  flex-direction: row;
  position: relative;
  border-radius: 16rpx;
  background: rgba(255, 250, 244, 0.66);
}

.chart-y-axis {
  width: 80rpx;
  height: 100%;
  flex-shrink: 0;
  background-color: rgba(255, 251, 246, 0.96);
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 60rpx 0 80rpx 0;
  box-sizing: border-box;
}

.y-axis-canvas {
  width: 80rpx;
  height: 280px;
}

.chart-scroll-area {
  flex: 1;
  height: 100%;
  overflow-x: scroll;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.chart-content {
  display: inline-block;
  height: 100%;
  padding: 60rpx 40rpx 80rpx 0;
  box-sizing: border-box;
}

.medical-chart {
  display: block;
}

.chart-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 50rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(210, 136, 64, 0.82);
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  z-index: 20;
}

.chart-arrow-left {
  left: 90rpx;
}

.chart-arrow-right {
  right: 10rpx;
}

.chart-arrow.disabled {
  background: rgba(191, 164, 138, 0.5);
  color: rgba(255, 255, 255, 0.72);
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(22rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes panelEnter {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes valuePop {
  0% {
    opacity: 0.72;
    transform: scale(0.94);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes activePop {
  0% {
    transform: scale(0.96);
  }
  70% {
    transform: scale(1.035);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes historyDrop {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes listFade {
  from {
    opacity: 0;
    transform: translateX(12rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
