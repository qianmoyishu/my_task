<view class="container">
  <!-- 头部信息 -->
  <view class="header">
    <text class="title">健康监测</text>
    <view class="actions">
      <van-button icon="setting-o" size="small" type="primary" bind:click="showSettingsPanel">设置</van-button>
      <van-button icon="replay" size="small" type="info" bind:click="handleManualRefresh" loading="{{isLoading}}">刷新</van-button>
    </view>
  </view>

  <!-- 设备信息 -->
  <view class="device-info">
    <view class="device-name">设备: {{deviceInfo.name || '医疗设备'}}</view>
    <view class="device-status">
      状态: <text class="{{deviceStatus === '在线' ? 'status-online' : 'status-offline'}}">{{deviceStatus}}</text>
    </view>
    <view class="last-updated">更新时间: {{lastUpdatedTime || '暂无数据'}}</view>
  </view>

  <!-- 错误提示 -->
  <van-notice-bar wx:if="{{error}}" mode="closeable" text="{{error}}" />

  <!-- 热成像图卡片 -->
  <view class="data-card thermal-card">
    <view class="card-header">
      <text class="card-title">红外热成像 (6×8)</text>
      <text class="temp-range">{{thermalGrid.minTemp}}°C ~ {{thermalGrid.maxTemp}}°C</text>
    </view>
    <view class="card-body">
      <!-- 色阶方案选择 -->
      <view class="color-scheme-selector">
        <text class="scheme-label">色阶:</text>
        <view class="scheme-btn {{colorScheme === 'iron' ? 'active' : ''}}" data-scheme="iron" bindtap="changeColorScheme">铁红</view>
        <view class="scheme-btn {{colorScheme === 'rainbow' ? 'active' : ''}}" data-scheme="rainbow" bindtap="changeColorScheme">彩虹</view>
        <view class="scheme-btn {{colorScheme === 'medical' ? 'active' : ''}}" data-scheme="medical" bindtap="changeColorScheme">医疗</view>
        <view class="scheme-btn {{colorScheme === 'classic' ? 'active' : ''}}" data-scheme="classic" bindtap="changeColorScheme">经典</view>
      </view>
      
      <!-- Canvas热成像图 -->
      <view class="thermal-canvas-container">
        <canvas canvas-id="thermalCanvas" class="thermal-canvas" style="width: 300px; height: 180px;"></canvas>
      </view>
      
      <!-- 温度数据展示 -->
      <view class="thermal-grid" wx:if="{{thermalGrid.gridData.length > 0}}">
        <view class="thermal-row" wx:for="{{thermalGrid.gridData}}" wx:key="index" wx:for-item="row">
          <view class="thermal-cell" wx:for="{{row}}" wx:key="index" wx:for-item="cell" style="background-color: {{cell.color}};">
            <text class="cell-temp">{{cell.temp}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="no-thermal-data">暂无热成像数据</view>
      
      <!-- 温度统计 -->
      <view class="thermal-stats">
        <view class="stat-item"><text class="stat-label">最低:</text><text class="stat-value">{{thermalGrid.minTemp}}°C</text></view>
        <view class="stat-item"><text class="stat-label">平均:</text><text class="stat-value">{{thermalGrid.avgTemp}}°C</text></view>
        <view class="stat-item"><text class="stat-label">最高:</text><text class="stat-value">{{thermalGrid.maxTemp}}°C</text></view>
      </view>
    </view>
  </view>

  <!-- 传感器数据卡片 -->
  <view class="data-cards">
    <!-- GSR皮肤电导 -->
    <view class="data-card gsr-card">
      <view class="card-header">
        <text class="card-title">皮肤电导 (GSR)</text>
        <text>{{gsr.current}} {{gsr.unit}}</text>
      </view>
      <view class="card-body">
        <view class="progress-container">
          <progress percent="{{(gsr.current / gsr.max) * 100}}" stroke-width="12" active color="#1989fa" />
          <view class="scale"><text>{{gsr.min}}</text><text>{{gsr.max}}</text></view>
        </view>
      </view>
    </view>

    <!-- MLX温度 -->
    <view class="data-card temp-card">
      <view class="card-header">
        <text class="card-title">体表温度 (MLX)</text>
        <text class="{{mlxTemp.current > 37.5 ? 'warning' : ''}}">{{mlxTemp.current}} {{mlxTemp.unit}}</text>
      </view>
      <view class="card-body">
        <view class="progress-container">
          <progress percent="{{(mlxTemp.current / mlxTemp.max) * 100}}" stroke-width="12" active color="{{mlxTemp.current > 37.5 ? '#ff4d4f' : '#07c160'}}" />
          <view class="scale"><text>{{mlxTemp.min}}°C</text><text>{{mlxTemp.max}}°C</text></view>
        </view>
      </view>
    </view>

    <!-- 心率 -->
    <view class="data-card heart-card">
      <view class="card-header">
        <text class="card-title">心率</text>
        <text class="{{heartRate.current > 100 || heartRate.current < 60 ? 'warning' : ''}}">{{heartRate.current}} {{heartRate.unit}}</text>
      </view>
      <view class="card-body">
        <view class="progress-container">
          <progress percent="{{(heartRate.current / heartRate.max) * 100}}" stroke-width="12" active color="{{heartRate.current > 100 || heartRate.current < 60 ? '#ff4d4f' : '#f39c12'}}" />
          <view class="scale"><text>{{heartRate.min}} bpm</text><text>{{heartRate.max}} bpm</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 设置面板 -->
  <van-popup show="{{showSettings}}" round position="bottom" custom-style="height: 80%" bind:close="hideSettingsPanel">
    <view class="settings-container">
      <view class="settings-header"><text class="settings-title">华为云IoTDA配置</text></view>
      <form bindsubmit="saveSettings">
        <van-field label="IAM端点地址" name="iamEndpoint" value="{{settingsForm.iamEndpoint}}" placeholder="iam.cn-north-4.myhuaweicloud.com" required data-field="iamEndpoint" bind:change="onInputChange" />
        <van-field label="账户名" name="userName" value="{{settingsForm.userName}}" placeholder="华为云账户名" required data-field="userName" bind:change="onInputChange" />
        <van-field label="IAM用户名" name="iamUserName" value="{{settingsForm.iamUserName}}" placeholder="IAM用户名" required data-field="iamUserName" bind:change="onInputChange" />
        <van-field label="IAM密码" name="iamUserPassword" value="{{settingsForm.iamUserPassword}}" placeholder="IAM密码" password required data-field="iamUserPassword" bind:change="onInputChange" />
        <van-field label="项目名" name="productName" value="{{settingsForm.productName}}" placeholder="cn-north-4" required data-field="productName" bind:change="onInputChange" />
        <van-field label="IoTDA端点地址" name="iotDAEndpoint" value="{{settingsForm.iotDAEndpoint}}" placeholder="xxx.iotda-app.cn-north-4.myhuaweicloud.com" required data-field="iotDAEndpoint" bind:change="onInputChange" />
        <van-field label="产品ID" name="product_id" value="{{settingsForm.product_id}}" placeholder="产品ID" required data-field="product_id" bind:change="onInputChange" />
        <van-field label="设备ID" name="device_id" value="{{settingsForm.device_id}}" placeholder="设备ID" required data-field="device_id" bind:change="onInputChange" />
        <van-field label="刷新间隔(毫秒)" name="refreshInterval" value="{{settingsForm.refreshInterval}}" placeholder="5000" type="number" required data-field="refreshInterval" bind:change="onInputChange" />
        <view class="form-buttons">
          <button form-type="submit" type="primary">保存配置</button>
          <button type="default" bindtap="hideSettingsPanel">取消</button>
        </view>
      </form>
    </view>
  </van-popup>
</view>
