/* pages/setting/setting.wxss */

/* 锁屏样式 */
.lock-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  background: linear-gradient(180deg, rgba(255, 248, 239, 0.7) 0%, rgba(255, 238, 218, 0.82) 100%);
  border-radius: 24rpx;
}

.lock-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  filter: drop-shadow(0 10rpx 20rpx rgba(220, 144, 75, 0.2));
}

.lock-text {
  font-size: 32rpx;
  color: #8e705c;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
  color: #684c39;
}

.subtitle {
  font-size: 26rpx;
  color: #9b7f6c;
}

.settings-card {
  background: linear-gradient(180deg, rgba(255, 251, 246, 0.98) 0%, rgba(255, 243, 232, 0.98) 100%);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #c9782f;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.help-icon {
  margin-left: 10rpx;
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #efb267 0%, #d77a2f 100%);
  color: white;
  font-size: 22rpx;
  box-shadow: 0 6rpx 12rpx rgba(215, 122, 47, 0.18);
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1px solid rgba(232, 190, 145, 0.72);
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background-color: rgba(255, 255, 255, 0.94);
  color: var(--text-color);
}

.threshold-input {
  padding: 0 20rpx;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  gap: 20rpx;
}

.save-btn, .reset-btn {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.save-btn {
  background: linear-gradient(135deg, #efb267 0%, #d77a2f 100%);
  color: white;
  box-shadow: 0 10rpx 20rpx rgba(215, 122, 47, 0.22);
}

.reset-btn {
  background-color: rgba(255, 249, 242, 0.96);
  color: #8a6752;
  border: 1px solid rgba(232, 190, 145, 0.72);
}

.tip-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.tip-content {
  width: 80%;
  background: linear-gradient(180deg, rgba(255, 251, 246, 1) 0%, rgba(255, 242, 229, 1) 100%);
  border-radius: 18rpx;
  overflow: hidden;
}

.tip-text {
  padding: 40rpx;
  font-size: 28rpx;
  text-align: center;
  color: #6a4b37;
}

.tip-close {
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border-top: 1px solid rgba(232, 190, 145, 0.55);
  color: #c9782f;
  font-size: 30rpx;
} 
