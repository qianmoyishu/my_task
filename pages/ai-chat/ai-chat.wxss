.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #faf6f0;
}

.status-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0e8dd;
}

.status-bar.online {
  background: #f0faf0;
}

.status-bar.offline {
  background: #fafafa;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #999;
}

.status-bar.online .status-dot {
  background: #4CAF50;
}

.status-text {
  font-size: 24rpx;
  color: #888;
}

.status-bar.online .status-text {
  color: #4CAF50;
}

.message-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
}

.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.message-row.user .avatar {
  background: #d77a2f;
}

.message-row.assistant .avatar {
  background: #E4A15D;
}

.bubble {
  max-width: 65%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 16rpx;
  word-break: break-all;
}

.bubble.user {
  background: #d77a2f;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.bubble.assistant {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.5;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  animation: typing 1.2s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0e8dd;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.quick-actions {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  background: #faf6f0;
}

.quick-action {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  color: #a85c22;
  background: #fff;
  border: 1rpx solid #f0cfaf;
  font-size: 24rpx;
}

.quick-action[disabled] {
  color: #bbb;
  border-color: #eee;
  background: #f6f3ef;
}

.quick-action::after {
  border: none;
}

.input-field {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f0ea;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #fff;
  background: #ccc;
  border: none;
}

.send-btn.active {
  background: #d77a2f;
}

.send-btn::after {
  border: none;
}
