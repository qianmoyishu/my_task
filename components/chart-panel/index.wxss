.chart-panel {
  margin-top: 24rpx;
}

.slider-chart-wrapper {
  padding: 16rpx 0 0 0;
  background: rgba(255, 245, 232, 0.95);
  border-radius: 14rpx 14rpx 0 0;
  animation: panelEnter 260ms ease-out both;
}

.slider-data {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
  padding: 0 20rpx;
}

.slider-time,
.page-hint {
  color: #9a7f6d;
}

.slider-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #d77a2f;
}

.slider-line-container {
  position: relative;
  height: 80rpx;
  margin-left: 80rpx;
  margin-right: 60rpx;
}

.data-slider {
  margin: 0;
  width: 100%;
}

.slider-indicator-line {
  position: absolute;
  top: 50rpx;
  height: 620rpx;
  width: 4rpx;
  background: repeating-linear-gradient(
    to bottom,
    #d77a2f 0,
    #d77a2f 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 25;
  transition: left 0.1s ease-out;
}

.chart-container-wrapper {
  width: 100%;
  height: 600rpx;
  margin-top: 30rpx;
  display: flex;
  flex-direction: row;
  position: relative;
  border-radius: 16rpx;
  background: rgba(255, 250, 244, 0.66);
}

.chart-y-axis {
  width: 80rpx;
  height: 100%;
  flex-shrink: 0;
  background-color: rgba(255, 251, 246, 0.96);
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 60rpx 0 80rpx 0;
  box-sizing: border-box;
}

.y-axis-canvas {
  width: 80rpx;
  height: 280px;
}

.chart-scroll-area {
  flex: 1;
  height: 100%;
  overflow-x: scroll;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.chart-content {
  display: inline-block;
  height: 100%;
  padding: 60rpx 40rpx 80rpx 0;
  box-sizing: border-box;
}

.medical-chart {
  display: block;
}

.chart-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 50rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(210, 136, 64, 0.82);
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  z-index: 20;
}

.chart-arrow-left {
  left: 90rpx;
}

.chart-arrow-right {
  right: 10rpx;
}

.chart-arrow.disabled {
  background: rgba(191, 164, 138, 0.5);
  color: rgba(255, 255, 255, 0.72);
}

.chart-page-bar {
  text-align: center;
  margin-top: 10rpx;
}
