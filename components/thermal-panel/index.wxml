<view class="card thermal-card panel-enter">
  <view class="thermal-header">
    <view class="thermal-title">红外热成像 (6x8)</view>
    <view class="thermal-range">{{thermalGrid.minTemp}}°C ~ {{thermalGrid.maxTemp}}°C</view>
  </view>

  <view class="thermal-history-nav" wx:if="{{thermalHistory.length > 1}}">
    <view class="thermal-nav-btn {{thermalHistoryIndex >= thermalHistory.length - 1 ? 'disabled' : ''}}"
          hover-class="pressable" hover-stay-time="90" bindtap="onPrev">更早</view>
    <view class="thermal-nav-info">
      <text class="thermal-time">{{thermalHistory[thermalHistoryIndex].time}}</text>
      <text class="thermal-page">{{thermalHistoryIndex + 1}} / {{thermalHistory.length}}</text>
    </view>
    <view class="thermal-nav-btn {{thermalHistoryIndex <= 0 ? 'disabled' : ''}}"
          hover-class="pressable" hover-stay-time="90" bindtap="onNext">更新</view>
  </view>

  <view class="color-scheme-bar">
    <view class="scheme-btn {{colorScheme === 'iron' ? 'active' : ''}}"
          hover-class="pressable" hover-stay-time="90" data-scheme="iron" bindtap="onSchemeChange">铁红</view>
    <view class="scheme-btn {{colorScheme === 'fire' ? 'active' : ''}}"
          hover-class="pressable" hover-stay-time="90" data-scheme="fire" bindtap="onSchemeChange">火焰</view>
    <view class="scheme-btn {{colorScheme === 'classic' ? 'active' : ''}}"
          hover-class="pressable" hover-stay-time="90" data-scheme="classic" bindtap="onSchemeChange">经典</view>
    <view class="scheme-btn {{colorScheme === 'medical' ? 'active' : ''}}"
          hover-class="pressable" hover-stay-time="90" data-scheme="medical" bindtap="onSchemeChange">医疗</view>
  </view>

  <view class="thermal-canvas-wrap">
    <canvas canvas-id="thermalCanvas" class="thermal-canvas" style="width: 300px; height: 180px;"></canvas>
  </view>

  <view class="thermal-grid" wx:if="{{thermalGrid.gridData.length > 0}}">
    <view class="thermal-row" wx:for="{{thermalGrid.gridData}}" wx:key="index" wx:for-item="row">
      <view class="thermal-cell" wx:for="{{row}}" wx:key="index" wx:for-item="cell" style="background-color: {{cell.color}};">
        <text class="cell-temp">{{cell.temp}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="no-thermal">暂无热成像数据</view>

  <view class="thermal-stats">
    <view class="stat-item"><text class="stat-label">最低</text><text class="stat-val">{{thermalGrid.minTemp}}C</text></view>
    <view class="stat-item"><text class="stat-label">平均</text><text class="stat-val">{{thermalGrid.avgTemp}}C</text></view>
    <view class="stat-item"><text class="stat-label">最高</text><text class="stat-val">{{thermalGrid.maxTemp}}C</text></view>
  </view>
</view>
