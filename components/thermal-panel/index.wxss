.thermal-card {
  border-top: 8rpx solid #ea9147;
  background: linear-gradient(180deg, rgba(255, 249, 241, 0.98) 0%, rgba(255, 241, 225, 0.98) 100%);
}

.panel-enter {
  animation: panelEnter 320ms ease-out both;
}

.thermal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.thermal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6a4b37;
}

.thermal-range,
.thermal-page,
.stat-label {
  color: #9a7f6d;
}

.thermal-history-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: rgba(255, 246, 233, 0.96);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.thermal-nav-btn {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #eca45c 0%, #d77a2f 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  transition: transform 140ms ease, opacity 140ms ease;
}

.thermal-nav-btn.disabled {
  background: #d7c3b3;
  color: #fff7ef;
}

.thermal-nav-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thermal-time {
  font-size: 24rpx;
  color: #7f614d;
}

.color-scheme-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.scheme-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(232, 190, 145, 0.7);
  border-radius: 999rpx;
  color: #8a6752;
  background: rgba(255, 248, 238, 0.95);
  transition: transform 140ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.scheme-btn.active {
  background: linear-gradient(135deg, #efb267 0%, #d77a2f 100%);
  color: #fff;
  border-color: #d77a2f;
  box-shadow: 0 8rpx 16rpx rgba(214, 122, 48, 0.2);
  animation: activePop 220ms ease-out both;
}

.thermal-canvas-wrap {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.thermal-canvas {
  border: 1rpx solid rgba(232, 190, 145, 0.46);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5), 0 10rpx 20rpx rgba(196, 126, 61, 0.1);
}

.thermal-grid {
  display: flex;
  flex-direction: column;
  margin: 20rpx 0;
}

.thermal-row {
  display: flex;
  justify-content: center;
}

.thermal-cell {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  transition: transform 160ms ease, opacity 160ms ease;
}

.cell-temp {
  font-size: 18rpx;
  color: #fff;
  text-shadow: 0 0 2px rgba(67, 35, 12, 0.85);
}

.no-thermal {
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
}

.thermal-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(255, 245, 232, 0.95);
  border-radius: 14rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #6a4b37;
}
