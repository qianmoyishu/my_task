.history-container {
  margin-top: 30rpx;
}

.available-dates-row {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: rgba(255, 245, 232, 0.94);
  border-radius: 14rpx;
}

.dates-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dates-actions {
  display: flex;
  gap: 12rpx;
}

.date-label,
.obs-loading,
.no-data,
.no-dates,
.page-info,
.history-time {
  color: #9a7f6d;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(232, 190, 145, 0.55);
}

.history-title {
  font-size: 28rpx;
  font-weight: 700;
}

.history-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-refresh,
.history-toggle,
.refresh-dates-btn,
.clear-dates-btn {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 231, 0.92);
  transition: transform 140ms ease, opacity 140ms ease;
}

.history-refresh,
.history-toggle,
.refresh-dates-btn {
  color: #c66a17;
  border: 1rpx solid rgba(217, 130, 43, 0.45);
}

.clear-dates-btn {
  color: #c4695d;
  border: 1rpx solid rgba(202, 106, 99, 0.45);
  background: rgba(255, 244, 241, 0.92);
}

.history-body-show {
  max-height: 400rpx;
  transition: max-height 0.3s ease;
  overflow: hidden;
  animation: historyDrop 260ms ease-out both;
}

.history-body-hide {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.history-list {
  max-height: 400rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(241, 220, 200, 0.8);
  animation: listFade 240ms ease-out both;
}

.history-time {
  font-size: 24rpx;
}

.history-value {
  font-size: 26rpx;
  font-weight: 700;
}

.no-data,
.no-dates {
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
}

.dates-scroll {
  white-space: nowrap;
  padding: 8rpx 0;
}

.date-tag {
  display: inline-block;
  padding: 12rpx 20rpx;
  margin-right: 12rpx;
  background: rgba(255, 251, 246, 0.96);
  border: 1rpx solid rgba(232, 190, 145, 0.62);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #7d604d;
  transition: transform 140ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.date-tag.selected {
  background: linear-gradient(135deg, #efb267 0%, #d77a2f 100%);
  color: #fff;
  border-color: #d77a2f;
  animation: activePop 220ms ease-out both;
}

.date-tag.selected.empty {
  background: #baa28d;
  border-color: #baa28d;
  color: #fff;
}

.obs-badge {
  font-size: 22rpx;
  color: #c57933;
  font-weight: 400;
  margin-left: 10rpx;
}

.history-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0 0 0;
}

.page-btn {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 231, 0.92);
  color: #c66a17;
  border: 1rpx solid rgba(217, 130, 43, 0.45);
  font-size: 22rpx;
  transition: transform 140ms ease, opacity 140ms ease;
}
