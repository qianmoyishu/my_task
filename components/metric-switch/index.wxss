.switch-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin: 18rpx 0 12rpx 0;
  width: 100%;
}

.switch-group {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  width: 100%;
  flex-wrap: wrap;
}

.switch-btn {
  flex: 1;
  min-width: 0;
  max-width: 200rpx;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 236, 0.92);
  color: #8a6752;
  border: 1rpx solid rgba(232, 190, 145, 0.62);
  font-weight: 700;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.switch-btn.active {
  background: linear-gradient(135deg, #efb267 0%, #d67a30 100%);
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(214, 122, 48, 0.22);
}

.thermal-btn {
  background: rgba(255, 236, 215, 0.95) !important;
  color: #bc6422 !important;
  border: 1rpx solid rgba(235, 154, 78, 0.52) !important;
}

.thermal-btn.active {
  background: linear-gradient(135deg, #f29d54 0%, #dd7438 100%) !important;
  color: #fff !important;
  box-shadow: 0 8rpx 16rpx rgba(221, 116, 56, 0.22);
}
