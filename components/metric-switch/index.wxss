.switch-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin: 18rpx 0 12rpx 0;
  width: 100%;
  animation: switchEnter 360ms ease-out 120ms both;
}

.switch-group {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  width: 100%;
  flex-wrap: wrap;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 246, 235, 0.72);
  border: 1rpx solid rgba(232, 190, 145, 0.34);
  box-sizing: border-box;
}

.switch-btn {
  flex: 1;
  min-width: 0;
  max-width: 200rpx;
  min-height: 64rpx;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 236, 0.92);
  color: #8a6752;
  border: 1rpx solid rgba(232, 190, 145, 0.62);
  font-weight: 700;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: transform 140ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.switch-btn.active {
  background: linear-gradient(135deg, #efb267 0%, #d67a30 100%);
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(214, 122, 48, 0.22);
  animation: activePop 220ms ease-out both;
}

.switch-btn-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.metric-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #d77a2f;
  box-shadow: 0 0 0 4rpx rgba(215, 122, 47, 0.12);
}

.gsr-dot {
  background: #cf8a42;
}

.temp-dot {
  background: #e2a84a;
}

.heart-dot {
  background: #c96f66;
}

.thermal-dot {
  background: #dd7438;
}

.switch-btn.active .metric-dot {
  background: #fff8ec;
  box-shadow: 0 0 0 5rpx rgba(255, 255, 255, 0.18);
}

.thermal-btn {
  background: rgba(255, 236, 215, 0.95) !important;
  color: #bc6422 !important;
  border: 1rpx solid rgba(235, 154, 78, 0.52) !important;
}

.thermal-btn.active {
  background: linear-gradient(135deg, #f29d54 0%, #dd7438 100%) !important;
  color: #fff !important;
  box-shadow: 0 8rpx 16rpx rgba(221, 116, 56, 0.22);
}

@keyframes switchEnter {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes activePop {
  0% {
    transform: scale(0.96);
  }
  70% {
    transform: scale(1.035);
  }
  100% {
    transform: scale(1);
  }
}
