.device-selector-card {
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.98) 0%, rgba(255, 236, 214, 0.98) 100%);
  border: 1rpx solid rgba(232, 190, 145, 0.42);
  border-radius: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(202, 144, 74, 0.12);
  animation: cardEnter 360ms ease-out both;
}

.selector-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.selector-label {
  font-size: 28rpx;
  color: #8d6f5b;
  flex-shrink: 0;
}

.device-key-input {
  flex: 1;
  min-width: 280rpx;
  height: 68rpx;
  padding: 0 22rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(232, 190, 145, 0.78);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #5c4638;
  box-sizing: border-box;
}

.submit-key-btn {
  min-width: 132rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  text-align: center;
  background: linear-gradient(135deg, #eca85f 0%, #d77a2f 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(215, 122, 47, 0.24);
  transition: transform 140ms ease, opacity 140ms ease;
}

.current-device-info {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(232, 190, 145, 0.42);
  display: flex;
  align-items: center;
}

.current-label {
  font-size: 26rpx;
  color: #9f8573;
  margin-right: 10rpx;
}

.current-name {
  font-size: 28rpx;
  color: #bc6b2d;
  font-weight: 600;
}

.header-card {
  margin-bottom: 28rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(255, 247, 236, 0.98) 0%, rgba(255, 232, 206, 0.98) 100%);
  border: 1rpx solid rgba(232, 190, 145, 0.42);
  border-radius: 18rpx;
  box-shadow: 0 14rpx 34rpx rgba(214, 145, 74, 0.16);
  animation: cardEnter 420ms ease-out 60ms both;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.header-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.header-kicker {
  font-size: 22rpx;
  color: #b97b45;
  margin-bottom: 10rpx;
}

.device-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #6a4b37;
}

.device-status {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 10rpx;
}

.dot-online {
  background-color: #7a9d58;
  animation: onlinePulse 1.8s ease-out infinite;
}

.dot-offline {
  background-color: #ca6a63;
}

.status-text {
  color: #8a6752;
  font-weight: 600;
}

.updated-time {
  margin-top: 20rpx;
  color: #9f7f69;
  font-size: 24rpx;
}

.refresh-button {
  background: linear-gradient(135deg, #f0b46a 0%, #db8542 100%);
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 20rpx rgba(219, 133, 66, 0.22);
  flex-shrink: 0;
  transition: transform 140ms ease, opacity 140ms ease;
}

.loading {
  animation: rotating 1.5s linear infinite;
}

@keyframes rotating {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.error-card {
  padding: 30rpx;
  background: linear-gradient(135deg, #fff6f3 0%, #ffefea 100%);
  border-left: 8rpx solid #ca6a63;
  border-radius: 18rpx;
  animation: cardEnter 260ms ease-out both;
}

.error-message {
  color: #ca6a63;
  font-size: 28rpx;
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(22rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes onlinePulse {
  0% {
    box-shadow: 0 0 0 0 rgba(122, 157, 88, 0.32);
  }
  70% {
    box-shadow: 0 0 0 12rpx rgba(122, 157, 88, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(122, 157, 88, 0);
  }
}
