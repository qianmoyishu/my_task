<view class="device-overview">
  <view class="card device-selector-card">
    <view class="selector-row">
      <text class="selector-label">设备密钥:</text>
      <input
        class="device-key-input"
        type="text"
        placeholder="输入密钥"
        value="{{deviceKeyInput}}"
        bindinput="onInput"
      />
      <view class="submit-key-btn" bindtap="onSubmit">确认</view>
    </view>
    <view class="current-device-info" wx:if="{{deviceName}}">
      <text class="current-label">当前设备:</text>
      <text class="current-name">{{deviceName}}</text>
    </view>
  </view>

  <view class="card header-card">
    <view class="header-top">
      <view class="header-main">
        <view class="header-kicker">暖光监测面板</view>
        <view class="device-name">{{deviceName || '未选择设备'}}</view>
        <view class="device-status">
          <view class="dot {{deviceStatus === '在线' ? 'dot-online' : 'dot-offline'}}"></view>
          <text class="status-text">{{deviceStatus}}</text>
        </view>
      </view>
      <view class="refresh-button" bindtap="onRefresh">
        <view class="{{isLoading ? 'loading' : ''}}">刷新</view>
      </view>
    </view>
    <view class="updated-time">上次更新: {{lastUpdatedTime}}</view>
  </view>

  <view wx:if="{{error}}" class="card error-card">
    <view class="error-message">{{error}}</view>
  </view>
</view>
